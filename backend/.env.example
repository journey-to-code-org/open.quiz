NODE_ENV=development

# MongoDB — use a local mongod or a free MongoDB Atlas cluster.
#MONGO_URI=mongodb://127.0.0.1:27017/openquiz
# Optional module ID used when a request does not select installed content.
# DEFAULT_MODULE_ID=
LESSON_IMPORT_SECRET=replace_with_a_shared_import_secret

# Public showcase only: every verified sign-in becomes an admin, other users' emails are hidden,
# and admins cannot manage other accounts. See docs/development-setup.md#public-demo-mode.
# DEMO_MODE=false

# Auth & Frontend URLs
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Base URL this API is reachable at (used to build OAuth callback URLs).
API_URL=http://localhost:8080

# OAuth (Google/GitHub sign-in). Leave blank to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# Transactional email (Brevo). Leave BREVO_API_KEY blank in dev to skip real sends.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
FROM_EMAIL=noreply@example.com
FROM_NAME=open.quiz
# When true (dev only) the server logs verification links instead of failing when email is unavailable.
EMAIL_FAIL_OPEN=true

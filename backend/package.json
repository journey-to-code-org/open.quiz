{
  "name": "open-quiz-backend",
  "version": "0.0.0",
  "description": "Backend services for the open.quiz learning platform",
  "keywords": [
    "backend",
    "mongodb",
    "cloud",
    "learning-platform",
    "collab",
    "team",
    "group"
  ],
  "homepage": "https://github.com/Code-the-Dream-School/summer-26-js-practicum-team2#readme",
  "bugs": {
    "url": "https://github.com/Code-the-Dream-School/summer-26-js-practicum-team2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Code-the-Dream-School/summer-26-js-practicum-team2.git"
  },
  "license": "ISC",
  "author": "kwishart24,berenicerojas,BytesOfStrength,mnichols08",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server",
    "start": "node server",
    "demo:reset": "node scripts/resetDemoSite.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "lint": "eslint . --max-warnings 0 && echo 'Backend ESLint checks passed successfully'",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "open.quiz": "file:..",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.9",
    "supertest": "^7.3.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 60,
        "functions": 90,
        "lines": 85
      }
    }
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true,
    "unrs-resolver@1.12.2": true
  }
}

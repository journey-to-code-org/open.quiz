              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /admin/modules/:moduleId returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Module detail includes lessons', function () { pm.expect(pm.response.json().lessons).to.be.an('array'); });"

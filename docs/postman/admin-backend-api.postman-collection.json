{
  "info": {
    "_postman_id": "c2b5d8c7-3c58-4e88-8e59-5f90f0b1d8a1",
    "name": "open.quiz Admin API",
    "description": "Admin-only workflows for user and lesson management. Requires an authenticated admin session.",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('csrfToken') || !pm.environment.get('sessionCookie')) {",
          "  throw new Error('Run User API > Login first so shared csrfToken and sessionCookie values are populated.');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "verificationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "resetUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserPassword",
      "value": "P@ssword123!",
      "type": "string"
    },
    {
      "key": "newTestUserPassword",
      "value": "N3wP@ssword!",
      "type": "string"
    },
    {
      "key": "adminModuleId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminLessonId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /admin/status returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Admin status confirms access', function () { pm.expect(pm.response.json().isAdmin).to.eql(true); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "status"]
            }
          },
          "response": []
        },
        {
          "name": "List Admin Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /admin/users returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Admin users response is safe', function () { const body = pm.response.json(); pm.expect(body.users).to.be.an('array'); pm.expect(JSON.stringify(body)).not.to.include('password_hash'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users"]
            }
          },
          "response": []
        },
        {
          "name": "List Admin Modules",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /admin/modules returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Admin modules response is an array', function () { pm.expect(pm.response.json().modules).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/modules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "modules"]
            }
          },
          "response": []
        },
        {
          "name": "Create Admin Test Module",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST /admin/modules returns 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminModuleId', body.id);",
                  "pm.test('Created module has an ID', function () { pm.expect(body.id).to.eql('postman-admin-module'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "{{sessionCookie}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"postman-admin-module\",\n  \"title\": \"Postman admin module\",\n  \"lessons\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/modules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "modules"]
            }
          },
          "response": []
        },
        {
          "name": "Update Admin Test Module",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('PATCH /admin/modules/:moduleId returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Module title was updated', function () { pm.expect(pm.response.json().title).to.eql('Updated Postman admin module'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [

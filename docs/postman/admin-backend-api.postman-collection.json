        {
          "name": "Import Lesson Module",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST /admin/modules/import returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const responseJson = pm.response.json();",
                  "pm.test('Imported module response includes its ID', function () {",
                  "  pm.expect(responseJson.id).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"

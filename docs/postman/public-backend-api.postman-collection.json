  "item": [
    {
      "name": "Lessons",
      "item": [
        {
          "name": "Get Public Lesson Content",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('GET /lessons/public/:moduleId/:lessonId returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const responseJson = pm.response.json();",
                  "pm.test('Public lesson response includes module and lesson data', function () {",
                  "  pm.expect(responseJson.moduleData).to.be.an('object');",
                  "  pm.expect(responseJson.lessonData).to.be.an('object');",
                  "  pm.expect(responseJson.lessonData.id).to.eql('1.1');",
                  "});",
                  "pm.test('Public lesson response does not expose quiz answers', function () {",
                  "  pm.expect(pm.response.text()).not.to.include('correctResponse');",
                  "  pm.expect(pm.response.text()).not.to.include('explanation');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/lessons/public/openQuizIntroduction/1.1",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "v1",
                "lessons",
                "public",
                "openQuizIntroduction",
                "1.1"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Quizzes",
      "item": [
        {
          "name": "Check Quiz Answer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('POST /quizzes/check returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const responseJson = pm.response.json();",
                  "pm.test('Answer check returns correctness details', function () {",
                  "  pm.expect(responseJson.isCorrect).to.be.a('boolean');",
                  "  pm.expect(responseJson.correctChoiceIds).to.be.an('array');",
                  "  pm.expect(responseJson.explanation).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"moduleId\": \"openQuizIntroduction\",\n  \"microLessonId\": \"1.1.2\",\n  \"questionId\": \"1.1.2-q1\",\n  \"choiceIds\": \"b\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quizzes/check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quizzes", "check"]
            }
          },
          "response": []
        }
      ]
    }
  ]

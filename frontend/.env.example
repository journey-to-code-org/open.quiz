# Frontend API base URL for production deployments.
# Leave blank in local development to use Vite proxy (/api -> localhost:8080).
# Example: set this to the URL of your deployed backend.
# VITE_API_BASE_URL=https://your-backend.example.com
# Optional instance display name (defaults to open.quiz).
# VITE_APP_NAME=open.quiz
# Optional instance brand assets. Local URLs resolve from frontend/public.
# VITE_APP_LOGO_URL=/instance-assets/logo.svg
# VITE_APP_HERO_IMAGE_URL=/instance-assets/home-graphic.webp
# VITE_APP_FAVICON_URL=/instance-assets/favicon.svg
# Optional theme overrides. Font values must name fonts loaded by the deployment.
# VITE_THEME_PRIMARY=#315f9e
# VITE_THEME_PRIMARY_HOVER=#244a7d
# VITE_THEME_PRIMARY_ALT=#e8b34c
# VITE_THEME_ACCENT=#d8795f
# VITE_THEME_HEADING=#213c60
# VITE_THEME_FOREGROUND=#263244
# VITE_THEME_SURFACE=#f5f7fa
# VITE_THEME_SURFACE_RAISED=#ffffff
# VITE_THEME_SURFACE_INSET=#edf1f6
# VITE_THEME_FONT_HEADING="Poppins", sans-serif
# VITE_THEME_FONT_BODY="Inter", sans-serif
# VITE_THEME_RADIUS_SM=4px
# VITE_THEME_RADIUS_MD=8px
# VITE_THEME_RADIUS_LG=12px
# VITE_THEME_RADIUS_PILL=9999px
# Frontend API port for local development (Vite proxy).
# This should match the backend PORT in backend/.env. It defaults to 8080 if not set.
# VITE_API_PORT=5000
